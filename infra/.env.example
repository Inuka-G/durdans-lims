# --- Databases ---
LIMS_DB_USERNAME=postgres
LIMS_DB_PASSWORD=strong-password
KEYCLOAK_DB_PASSWORD=strong-password

# --- Keycloak admin console ---
KEYCLOAK_ADMIN_PASSWORD=strong-password

# --- Keycloak Admin API service account (app.keycloak-admin.*) ---
# A confidential client in lims-realm with a service account granted the
# realm-management client roles manage-users/view-users/query-users. Powers
# the admin module's Global User Control and branch-admin assignment.
# Leave the secret blank to keep app.keycloak-admin.enabled effectively
# inert even if it's toggled true.
KEYCLOAK_ADMIN_CLIENT_ID=lims-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Grafana admin ---
GRAFANA_ADMIN_PASSWORD=strong-password

MAIL_USERNAME=
MAIL_PASSWORD=

# --- SMS (OzoneDesk) ---
SMS_PROVIDER=mock
SMS_API_URL=http://sms.ozonedesk.com/api/v1/send.php
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=

# --- WhatsApp agent (Meta Cloud API) ---
# From the Meta app dashboard. Leave blank to keep the service refusing every webhook:
# an unconfigured deployment must reject traffic, never accept it unverified.
META_APP_ID=
META_APP_SECRET=
# Ours to choose, and echoed back to Meta during webhook subscription. Use 32 random
# bytes — it is the only thing preventing someone else registering our callback.
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
