<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20260816120000-1-scope-critical-values-to-supervision" author="codex">
        <comment>Make Critical Values a Lab Supervisor feature instead of a cross-role top-level module</comment>
        <delete tableName="header_mapping">
            <where>link_url = '/critical-values'</where>
        </delete>
        <insert tableName="header_mapping">
            <column name="id" value="20000000-0000-0000-0000-000000000206"/>
            <column name="role_name" value="LAB_SUPERVISOR"/>
            <column name="display_text" value="Critical Values"/>
            <column name="link_url" value="/critical-values"/>
            <column name="priority" value="65"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>
        <rollback>
            <delete tableName="header_mapping">
                <where>link_url = '/critical-values'</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>
