<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        The Super Admin "Branch management" screen rendered three hardcoded
        mock branches instead of the 22 real ones already seeded in this
        table (20260221183000_create_metadata_tables.xml) — this adds the
        columns that screen actually needs (contact details, status, the
        assigned admin) so it can read and write the real thing instead.
    -->
    <changeSet id="20260830130000-1-add-branch-detail-columns" author="claude">
        <addColumn tableName="branch">
            <column name="location" type="VARCHAR(120)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="contact_email" type="VARCHAR(255)"/>
            <column name="contact_phone" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="established_date" type="DATE"/>
            <column name="legal_entity_name" type="VARCHAR(255)"/>
            <!-- Keycloak subject of the assigned branch admin; name/email are
                 denormalized alongside it so the list/detail views don't need
                 a Keycloak round-trip per row. Left null until someone uses
                 "Assign admin" — no fabricated placeholder admin. -->
            <column name="admin_user_id" type="VARCHAR(64)"/>
            <column name="admin_name" type="VARCHAR(255)"/>
            <column name="admin_email" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
